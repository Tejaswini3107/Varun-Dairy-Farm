# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Database (Postgres via Supabase or local Docker) ─────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/varun_dairy

# ── API server ────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-in-production-use-64-char-random-string

# ── Razorpay (Indian payments) ────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ── Google Maps ───────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your-google-maps-key

# ── Firebase (push notifications) ────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── WhatsApp / SMS (Gupshup) ─────────────────────────────────────────────────
GUPSHUP_API_KEY=your-gupshup-key
GUPSHUP_APP_NAME=VarunDairy

# ── Web App (Vite) ────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
