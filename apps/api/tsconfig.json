{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "../..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "5.0",
    "baseUrl": "../..",
    "paths": {
      "@varun/shared": ["packages/shared/src/index.ts"],
      "@varun/database": ["packages/database/src/index.ts"]
    }
  },
  "include": ["src", "../../packages/shared/src", "../../packages/database/src"],
  "exclude": ["node_modules", "dist"]
}
